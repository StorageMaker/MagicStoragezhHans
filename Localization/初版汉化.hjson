						'''
						若开启，则存储中枢的快速堆叠功能需要按住Ctrl并左键单击使用，否则只需要左键单击即可
						将指针移动到存储中枢的“快速存入”按钮上以了解具体信息
						'''
				}

				useConfigFilter: {
					Label: "[i:MagicStorage/Config_RecipeFilterAvailable] [i:MagicStorage/Config_RecipeFilterAll]  使用默认筛选项"
					Tooltip: 开启以使用默认筛选项，关闭则会使用你上次选择的筛选项（模组重新加载后会重置至默认筛选项）
				}

				showAllRecipes: {
					Label: "[i:MagicStorage/Config_RecipeFilterAvailable] [i:MagicStorage/Config_RecipeFilterAll]  显示所有制作配方"
					Tooltip: 开启以默认显示所有制作配方，关闭则默认仅显示可用的制作配方
				}

				useOldCraftMenu: {
					Label: "[i:WorkBench]  使用旧版合成界面"
					Tooltip: 开启后，制作接口界面将使用旧版的界面
				}

				recipeBlacklist: {
					Label: 制作配方黑/白名单
					Tooltip: 开启后，可在制作接口界面中将制作配方加入白名单或黑名单
				}

				globalRecipeBlacklist: {
					Label: 全局制作配方黑名单
					Tooltip: 按住左 Ctrl + 左 Shift 再点击配方来将配方添加移除全局黑名单
				}

				clearHistory: {
					Label: "[i:Book]  清除配方历史记录"
					Tooltip: 在打开制作接口界面时自动清除配方历史记录
				}

				recursionCraftingDepth: {
					Label: 配方递归深度
					Tooltip:
						'''
						设置在制作接口中制作物品的最大递归深度。
						设置为 0 可禁用此功能。
						设置为 -1 则为无限深度。
						'''
				}

				glowNewItems: {
					Label: "[i:MagicStorage/Config_GlowItemGlowing] [i:MagicStorage/Config_GlowItemNotGlowing]  高亮显示新物品/配方"
					Tooltip: 高亮显示存储中枢与制作接口中的新物品和配方
				}

				clearSearchText: {
					Label: 自动清除搜索文本
					Tooltip: 开启后，每次打开存储中枢的UI界面都会自动清除上一次键入的搜索文本
				}

				searchBarRefreshOnKey: {
					Label: 搜索结果实时更新
					Tooltip: 开启后，存储中枢与制作接口面板的搜索结果将实时更新。如果关闭，则仅在搜索栏取消聚焦(即:点击面板的其他区域)时刷新搜索结果
				}

				uiFavorites: {
					Label: "[i:FallenStar]  收藏物品与配方"
					Tooltip: 开启后，可在制作接口界面中收藏物品和配方
				}

				extraFilterIcons: {
					Label: "[i:Cog]  更多排序选项"
					Tooltip: 开启后，在存储中枢的UI界面会显示更多排序选项
				}

				buttonLayout: {
					Label: 排序/筛选按钮布局
					Tooltip:
						'''
						Legacy (主界面按钮):
						  v0.5.6.5及以前版本的布局
						  排序和筛选选项不单独分页
						ModernPaged (独立分页):
						  排序和筛选按钮单独分页
						ModernConfigurable (自主配置):
						  可以单独选择一些排序和筛选按钮使其出现在主界面
						LegacyWithGear (主界面按钮+小窗按钮):
						  如果关闭了“更多排序选项”则与v0.5.6.5及以前版本一致
						  在主界面按钮右侧添加了一个齿轮按钮，点击后将以小窗形式显示额外的排序按钮
						  排序和筛选选项不单独分页
						LegacyBasicWithPaged (主界面按钮+独立分页):
						  如果关闭了“更多排序选项”则与v0.5.6.5及以前版本一致
						  额外的排序按钮独立分页
						ModernDropdown (下拉菜单):
						  在主界面添加了排序和筛选选项的下拉式菜单
						  排序和筛选选项不单独分页
						'''
				}

				itemDataDebug: {
					Label: "[i:IronPickaxe]  显示物品调试信息"
					Tooltip: 开启后，存放于存储面板的物品将显示其是否有GlobalItem数据，并允许通过按下“Print Item Data”(输出物品数据)快捷键以在聊天栏输出数据
				}

				canMovePanels: {
					Label: 流动UI面板
					Tooltip: 关闭后，UI界面将无法调节大小或进行拖动
				}

				automatonRemembers: {
					Label: 自动机记住上次的帮助提示
					Tooltip: 自动机会记住上次显示给用户的帮助提示，再次交互时将会显示出来.
				}

				globalShimmerItemBlacklist: {
					Label: 全局物品微光嬗变黑名单
					Tooltip: 按住左 Ctrl + 左 Shift 点击以添加/移除黑名单
				}
			}

			ButtonConfigurationMode: {
				Tooltip: "按钮配置模式"

				Legacy: {
					Label: Legacy
					Tooltip: 传统Mods.MagicStorage.Configs.ButtonConfigurationMode.Legacy.Tooltip
				}

				ModernPaged: {
					Label: Paged
					Tooltip: 分页Mods.MagicStorage.Configs.ButtonConfigurationMode.ModernPaged.Tooltip
				}

				ModernConfigurable: {
					Label: Configurable
					Tooltip: 可配置Mods.MagicStorage.Configs.ButtonConfigurationMode.ModernConfigurable.Tooltip
				}

				LegacyWithGear: {
					Label: Legacy + Configurable
					Tooltip: 传统+可配置Mods.MagicStorage.Configs.ButtonConfigurationMode.LegacyWithGear.Tooltip
				}

				LegacyBasicWithPaged: {
					Label: Legacy + Paged
					Tooltip: 传统 + 分页Mods.MagicStorage.Configs.ButtonConfigurationMode.LegacyBasicWithPaged.Tooltip
				}

				ModernDropdown: {
					Label: Dropdown
					Tooltip: 下拉菜单Mods.MagicStorage.Configs.ButtonConfigurationMode.ModernDropdown.Tooltip
				}
			}

			MagicStorageServerConfig: {
				DisplayName: 魔法存储服务器配置

				allowAutomatonToMoveIn: {
					Label: 自动机入住
					Tooltip: 允许城镇NPC“自动机”入住你的城镇
				}

				auditLog: {
					Label: 服务器审计日志
					Tooltip: 启用后，客户端与任何存储系统物品的交互都会记录到审计日志中
				}

				localHostAdmin: {
					Label: 赋予本地主机 服务器管理员权限
					Tooltip: 启用后，本地主机加入服务器时将被强制赋予服务器管理员身份
				}

				automatonHappiness: {
					Label: 自动机好感度影响售卖价格
					Tooltip: 禁用后，自动机将不会影响通过物品售卖模式售出的物品价格
				}
			}

			MagicStorageBetaConfig.DisplayName: "{$Mods.MagicStorage.Config.BetaLabel}"
		}
	}
}
