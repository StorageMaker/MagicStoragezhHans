# I recommend using the hjson key to translate all future text additions
# Also add them into other hjsons, but mark them with "//", and wait for translators to translate the text
# -Crapsky233

Mods: {
	MagicStorage: {
		Items: {
			BiomeGlobe: {
				DisplayName: 生态球
				Tooltip:
					'''
					“世界的力量凝聚环绕在你的指尖”
					制作物品时提供雪原环境、灵雾环境、水、熔岩、蜂蜜、恶魔/猩红祭坛的制作环境
					放在物品栏或制作接口的制作站槽位内即可生效
					放在物品栏时，不需要处在篝火旁即可将棒棒棉花糖烤熟
					放在制作接口的制作站槽位时，可直接用棉花糖制作熟棉花糖
					丢出去之后会像沙滩球一样弹弹弹，但不会消耗自身
					'''
			}

			CraftingAccess: {
				DisplayName: 制作接口
				Tooltip: 能够使用存储系统中的物品进行制作
			}

			CreativeStorageUnit: {
				DisplayName: 存储单元(创造模式)
				    Tooltip:
					'''
					存储了无限量的所有物品。
					不会影响所属存储系统的存储上限
					''' 
			}

			Locator: {
				DisplayName: 定位器
				Tooltip:
					'''
					<right>存储中枢以保存定位
					<right>远程中枢来导入存储中枢的定位
					'''
			}

			LocatorDisk: {
				DisplayName: 定位磁盘
				Tooltip:
					'''
					<right>存储中枢以保存定位
					<right>远程中枢来导入存储中枢的定位
					使用后不消耗自身
					'''
			}

			PortableAccess: {
				DisplayName: 便携远程存储装置(终极)
				Tooltip:
					'''
					<right>存储中枢以保存其定位,当前暂未定位到任何存储中枢
					使用以访问目标位置的存储中枢
					无距离限制
					'''
			}

			PortableCraftingAccess: {
				DisplayName: 便携远程制作装置(终极)
				Tooltip:
					'''
					<right>制作接口以保存其定位,当前暂未定位到任何制作接口
					使用以访问目标位置的制作接口
					无距离限制
					'''
			}

			RadiantJewel: {
				DisplayName: 璀璨棱晶
				Tooltip: 
					'''
					“辐射出耀眼的光芒”
					'''
			}

			RemoteAccess: {
				DisplayName: 远程中枢
				Tooltip:
					'''
					可远程打开某个存储中枢
					对于制作接口之类的存储元件来说，远程中枢的效果与存储中枢相同
					'''
			}

			ShadowDiamond: {
				DisplayName: 暗影钻石
				Tooltip: 
					'''
					“那道光所余留的痕迹依旧”
					'''
			}

			SnowBiomeEmulator: {
				DisplayName: 破损雪花球
				Tooltip: 
					'''
					允许制作接口制作需要身处雪地环境的配方
					'''
			}

			StorageAccess: {
				DisplayName: 存储访问器
				Tooltip: 可作为除存储中枢外，访问存储系统的一个额外访问点
			}

			StorageComponent: {
				DisplayName: 存储组件
				Tooltip: 一切魔法存储元件的基础制作材料
			}

			StorageConnector: {
				DisplayName: 存储连接器
				Tooltip: 可用于连接不同的魔法存储元件，使其并入同一存储系统内
			}

			StorageDeactivator: {
				DisplayName: 存储单元魔杖
				Tooltip:
					'''
					停用/启用相应的存储单元
					存储中枢会尝试将停用的存储单元内的物品转移到其他存储单元内
					若停用的存储单元未与任何存储中枢连接，则其本身并不会转移所存物品
					(原文仅说明停用的存储单元会转移自身物品，但这实际是存储中枢的作用效果)
					'''
			}

			StorageHeart: {
				DisplayName: 存储中枢
				Tooltip:
					'''
					魔法存储系统的最关键元件
					一个存储系统需要存储中枢来运作
					'''
			}

			StorageUnit: {
				DisplayName: 存储单元(基础)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 40 组物品
					'''
			}

			StorageUnitBlueChlorophyte: {
				DisplayName: 存储单元(蓝色叶绿)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 240 组物品
					'''
			}

			StorageUnitCrimtane: {
				DisplayName: 存储单元(猩红)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 80 组物品
					'''
			}

			StorageUnitDemonite: {
				DisplayName: 存储单元(魔金)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 80 组物品
					'''
			}

			StorageUnitHallowed: {
				DisplayName: 存储单元(神圣)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 160 组物品
					'''
			}

			StorageUnitHellstone: {
				DisplayName: 存储单元(狱岩)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 120 组物品
					'''
			}

			StorageUnitLuminite: {
				DisplayName: 存储单元(夜明)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 320 组物品
					'''
			}

			StorageUnitTerra: {
				DisplayName: 存储单元(泰拉)
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					可存储至多 640 组物品
					'''
			}

			StorageUnitTiny: {
				DisplayName: 存储单元(小)
				Tooltip:
					'''
					在魔法存储系统中存储物品的小元件
					可存储至多 4 组物品
					'''
			}

			UpgradeBlueChlorophyte: {
				DisplayName: 存储升级珠(蓝色叶绿)
				Tooltip:
					'''
					将存储单元(神圣)升级至240格容量
					<right>一个存储单元(神圣)来使用
					'''
			}

			UpgradeCrimtane: {
				DisplayName: 存储升级珠(猩红)
				Tooltip:
					'''
					将存储单元(基础)升级至80格容量
					<right>一个存储单元(基础)来使用
					'''
			}

			UpgradeDemonite: {
				DisplayName: 存储升级珠(魔金)
				Tooltip:
					'''
					将存储单元(基础)升级至80格容量
					<right>一个存储单元(基础)来使用
					'''
			}

			UpgradeHallowed: {
				DisplayName: 存储升级珠(神圣)
				Tooltip:
					'''
					将存储单元(狱岩)升级至160格容量
					<right>一个存储单元(狱岩)来使用
					'''
			}

			UpgradeHellstone: {
				DisplayName: 存储升级珠(狱岩)
				Tooltip:
					'''
					将存储单元(猩红)/(魔金)升级至120格容量
					<right>一个存储单元(猩红)/(魔金)来使用
					'''
			}

			UpgradeLuminite: {
				DisplayName: 存储升级珠(夜明)
				Tooltip:
					'''
					将存储单元(蓝色叶绿)升级至320格容量
					<right>一个存储单元(蓝色叶绿)来使用
					'''
			}

			UpgradeTerra: {
				DisplayName: 存储升级珠(泰拉)
				Tooltip:
					'''
					将存储单元(夜明)升级至640格容量
					<right>一个存储单元(夜明)来使用
					'''
			}

			CrimsonAltar: {
				DisplayName: 猩红祭坛
				Tooltip: 可放置的猩红祭坛复制品，挖掉不会发生任何事。
			}

			DemonAltar: {
				DisplayName: 恶魔祭坛
				Tooltip: 可放置的恶魔祭坛复制品，挖掉不会发生任何事。
			}

			CombinedFurnitureStations1Item: {
				DisplayName: 综合家具制作站(一级)
				Tooltip: 结合了部分原版家具制作站的功能
			}

			CombinedFurnitureStations2Item: {
				DisplayName: 综合家具制作站(二级)
				Tooltip: 结合了全部原版家具制作站的功能
			}

			CombinedStations1Item: {
				DisplayName: 综合制作站(一级)
				Tooltip: 结合了部分原版非家具制作站的功能
			}

			CombinedStations2Item: {
				DisplayName: 综合制作站(二级)
				Tooltip: 结合了部分原版非家具制作站的功能，包含了上一级制作站的功能
			}

			CombinedStations3Item: {
				DisplayName: 综合制作站(三级)
				Tooltip: 结合了部分原版非家具制作站的功能，包含了上一级制作站的功能
			}

			CombinedStations4Item: {
				DisplayName: 综合制作站(终级)
				Tooltip: 结合了一切原版制作站和水、岩浆、蜂蜜制作环境的功能
			}

			EnvironmentAccess: {
				DisplayName: 配置接口
				Tooltip:
					'''
					一个用于供其他模组与魔法存储系统进行跨模组访问的元件
					显示由其他模组添加的可开关的一系列跨模组功能模块，如果没有则不显示
					可用功能:
					<MODULES>
					'''
			}

			PortableAccessPreHM: {
				DisplayName: 便携远程存储装置(基础)
				Tooltip:
					'''
					<right>存储中枢以保存定位，当前暂未定位到任何存储中枢
					使用以访问定位的存储中枢
					要使该物品能在晶塔附近使用，目标定位的存储中枢与任何有效晶塔的距离须在100格以内。
					玩家只能在距离晶塔或定位的制作接口1000格范围内访问相应的存储中枢
					访问距离较小
					'''
			}

			PortableAccessHM: {
				DisplayName: 便携远程存储装置(进阶)
				Tooltip:
					'''
					<right>存储中枢以保存定位，当前暂未定位到任何存储中枢
					使用以访问定位的存储中枢
					要使该物品能在晶塔附近使用，目标定位的存储中枢与任何有效晶塔的距离须在200格以内。
					玩家只能在距离晶塔或定位的制作接口3000格范围内访问相应的存储中枢
					访问距离适中
					'''
			}

			Config_GlowItemGlowing: {
				DisplayName: Config//GlowItemGlowing
				// Tooltip: ""
			}

			Config_GlowItemNotGlowing: {
				DisplayName: Config//GlowItemNotGlowing
				// Tooltip: ""
			}

			Config_RecipeFilterAvailable: {
				DisplayName: Config//RecipeFilterAvailable
				// Tooltip: ""
			}

			Config_RecipeFilterAll: {
				DisplayName: Config//RecipeFilterAll
				// Tooltip: ""
			}

			PortableCraftingAccessPreHM: {
				DisplayName: 便携远程制作装置(基础)
				Tooltip:
					'''
					<right>制作接口以保存定位，当前暂未定位到任何制作接口
					使用以访问定位的制作接口
					要使该物品能在晶塔附近使用，目标定位的制作接口与任何有效晶塔的距离须在100格以内。
					玩家只能在距离晶塔或定位的制作接口1000格范围内访问相应的制作接口
					访问距离较小
					'''
			}

			PortableCraftingAccessHM: {
				DisplayName: 便携远程制作装置(进阶)
				Tooltip:
					'''
					<right>制作接口以保存定位，当前暂未定位到任何制作接口
					使用以访问定位的制作接口
					要使该物品能在晶塔附近使用，目标定位的制作接口与任何有效晶塔的距离须在200格以内。
					玩家只能在距离晶塔或定位的制作接口3000格范围内访问相应的制作接口
					访问距离适中
					'''
			}

			DecraftingAccess: {
				DisplayName: 微光接口
				Tooltip: 能够使用存储系统中的物品进行微光嬗变
			}

			Shimmer_CoinLuck: {
				DisplayName: Meta//Shimmer/Coin_Luck
				Tooltip: ""
			}

			StorageCore: {
				DisplayName: 存储核心(基础)
				Tooltip: "{$Mods.MagicStorage.Items.StorageCore.CommonTooltip}"
				CommonTooltip:
					'''
					存储了原本在存储单元中的物品
					<right> 一个空存储单元以插入
					<CAPACITY>
					<HASH>
					<BYTES>
					'''
				ItemsStored: "[c/{0}:{1} / {2} items]"
				Hash: Data hash: {0:x08}
				BytesUsed: "[c/{0}:{1} bytes]"
			}

			StorageCoreBlueChlorophyte.DisplayName: 存储核心(蓝色叶绿)
			StorageCoreCrimtane.DisplayName: 存储核心(猩红)
			StorageCoreDemonite.DisplayName: 存储核心(魔金)
			StorageCoreHallowed.DisplayName: 存储核心(神圣)
			StorageCoreHellstone.DisplayName: 存储核心(狱岩)
			StorageCoreLuminite.DisplayName: 存储核心(夜明)
			StorageCoreTerra.DisplayName: 存储核心(泰拉)

			StorageExtractor: {
				DisplayName: 存储核心扳手
				Tooltip: 可将存储核心从存储单元中提取出来
			}

			StorageUnitEmpty: {
				DisplayName: 空存储单元
				Tooltip:
					'''
					在魔法存储系统中存储物品的元件
					需要一个存储核心才能运作
					手持存储核心右键单击即可将其插入
					'''
			}

			StorageSecurity: {
				DisplayName: 存储安全魔杖
				Tooltip:
					'''
					<left> 存储中枢以打开安全网络
					可将私人网络分配给该存储中枢
					    设置了私人网络的存储中枢只能通过密码来访问
						(该私人网络创建者无需输入密码即可访问)
					'''
			}

			Error_ItemSlotRenderFail: {
				// DisplayName: Error//ItemRender
				// Tooltip: ""
			}

			Error_ItemNetReadFail: {
				// DisplayName: Error//ItemClientRead
				// Tooltip: ""
			}
		}

		Projectiles.BiomeGlobeThrown.DisplayName: 生态球

		NPCs: {
			Golem: {
				DisplayName: 自动机

				TownNPCMood: {
					Content: 系统运行中。
					NoHome: 暴露于外界将加快生锈速率，请求尽快设置居住所。
					LoveSpace: 已接受当前居住安排。
					FarFromHome: 本单元必须尽快回家以为蓝魔法设备充能
					DislikeCrowded: 附近检测到太多个体。
					HateCrowded: 本单元请求独处。
					LikeBiome: "{BiomeName}与蓝魔法相容。"
					LoveBiome: "{BiomeName}与蓝魔法完美协调。"
					DislikeBiome: 位于{BiomeName}，蓝魔法效率下降。
					HateBiome: 位于{BiomeName}，蓝魔法不稳定。
					LikeNPC: 检测到{NPCName}欣赏蓝魔法。
					LoveNPC: 附近的{NPCName}个体对本单元拥有一切操纵权.
					DislikeNPC: 本单元已后悔向{NPCName}提及蓝魔法。
					HateNPC: "{NPCName}需要改变其试图将蓝魔法用于盈利的想法"
					LikeNPC_Princess: "{NPCName}是我的创造者最好的朋友。"
					Princess_LovesNPC: "{NPCName}是如此有趣的机器，它是如何运作的？"
				}

				# Census support
				Census.SpawnCondition: '''"{$Mods.MagicStorage.Configs.MagicStorageServerConfig.allowAutomatonToMoveIn.Label}" 配置在 "{$Mods.MagicStorage.Configs.MagicStorageServerConfig.DisplayName}" 设置为启用'''
			}
		}

		EnvironmentModule: {
			UseInventoryModule: {
				DisplayName: 使用制作接口/微光接口时，可直接使用物品栏内物品
				DisabledTooltip: 该功能当前已禁用。
			}

			UseInventoryNoFavoritesModule: {
				DisplayName: 使用制作接口/微光接口时，可直接使用物品栏内未收藏的物品
				DisabledTooltip: 该功能当前已禁用。
			}

			JourneyInfiniteItems: {
				DisplayName: 使用制作接口/微光接口时，可直接使用旅途模式研究过的物品
				DisabledTooltip: 该功能仅供旅途模式人物使用。
			}
		}

